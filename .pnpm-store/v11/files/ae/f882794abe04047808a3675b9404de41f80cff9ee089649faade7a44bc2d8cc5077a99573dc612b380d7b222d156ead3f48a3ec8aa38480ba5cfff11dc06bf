language js

// anti-slop/no-module-mocking
// `vi.mock` / `jest.mock` (and their `doMock` / `unstable_mockModule` siblings) replace a
// real module graph with a fiction, so the test stops proving anything about the code that
// ships. Dependencies belong behind a seam the production code already has.
// Ported from oxlint-plugin-anti-slop `no-module-mocking`.
//
// GritQL has no scope analysis, so `vi` / `jest` are recognised by name, plus by the local
// name a `vitest` / `@jest/globals` import binds them to. Two guards keep the rule off code
// that owns those names itself:
//   * `anti_slop_binds_locally` -- a call sitting inside a function (or catch clause, or
//     for-of head) whose bindings mention the name is talking about that binding. This is
//     checked lexically with `within`, so a helper that takes a `vi` parameter does not
//     disable the rest of the file.
//   * `anti_slop_declared_in_file` -- a file that declares or imports its own `vi` / `jest`
//     binding is skipped entirely for that name. Coarser than the original's scope
//     resolution, but a false negative beats flagging correct code.

pattern anti_slop_mock_method() {
	or { `mock`, `doMock`, `unstable_mockModule` }
}

pattern anti_slop_mock_key() {
	or {
		`"mock"`,
		`'mock'`,
		`"doMock"`,
		`'doMock'`,
		`"unstable_mockModule"`,
		`'unstable_mockModule'`
	}
}

// The framework object itself: `vi`, or `(vi)` after a redundant paren.
pattern anti_slop_framework_object($name) {
	or {
		$name,
		JsParenthesizedExpression(expression = $inner) where { $inner <: $name }
	}
}

// A construct that binds $name for the code nested inside it. Class and object methods,
// setters, constructors, catch clauses and for-of/for-in heads are all reachable as CST
// node patterns, which snippet patterns cannot express.
pattern anti_slop_binds_locally($name) {
	or {
		JsFunctionDeclaration(parameters = $fnParams) where { $fnParams <: contains $name },
		JsFunctionExpression(parameters = $fnExprParams) where {
			$fnExprParams <: contains $name
		},
		JsFunctionExportDefaultDeclaration(parameters = $defaultParams) where {
			$defaultParams <: contains $name
		},
		JsArrowFunctionExpression(parameters = $arrowParams) where {
			$arrowParams <: contains $name
		},
		JsMethodClassMember(parameters = $methodParams) where {
			$methodParams <: contains $name
		},
		JsMethodObjectMember(parameters = $objectMethodParams) where {
			$objectMethodParams <: contains $name
		},
		JsConstructorClassMember(parameters = $ctorParams) where {
			$ctorParams <: contains $name
		},
		JsSetterClassMember(parameter = $setterParam) where { $setterParam <: contains $name },
		JsSetterObjectMember(parameter = $objectSetterParam) where {
			$objectSetterParam <: contains $name
		},
		JsCatchClause(declaration = $catchParam) where { $catchParam <: contains $name },
		JsForOfStatement(initializer = $forOfBinding) where {
			$forOfBinding <: contains $name
		},
		JsForInStatement(initializer = $forInBinding) where { $forInBinding <: contains $name }
	}
}

// A declaration or import that binds $name somewhere in the file. An import of the name
// from the framework's own package is what the original rule accepts as proof that this
// *is* the framework object, so it is deliberately not a shadow.
//
// The default import is matched through `JsDefaultImportSpecifier` rather than
// `JsImportDefaultClause`: in Biome 2.5.8 the latter, sitting in an `or` next to
// `JsImportNamedClause`, also matches plain named-import clauses and would silence every
// file that imports from vitest.
pattern anti_slop_declared_in_file($name, $framework) {
	or {
		JsVariableDeclarator(id = $declaredId) where { $declaredId <: contains $name },
		JsFunctionDeclaration(id = $functionId) where { $functionId <: $name },
		JsClassDeclaration(id = $classId) where { $classId <: $name },
		JsImportNamedClause(named_specifiers = $specifiers, source = $source) where {
			$specifiers <: contains $name,
			$source <: not $framework
		},
		JsDefaultImportSpecifier(local_name = $default) where { $default <: $name },
		JsNamespaceImportSpecifier(local_name = $namespace) where { $namespace <: $name }
	}
}

// Matching the call at CST level covers every spelling in one go: `vi.mock(...)`,
// `vi?.mock(...)`, `vi.mock?.(...)`, `vi.mock<T>(...)`, `vi["mock"](...)` and
// `vi?.["mock"](...)`. `new vi.mock()` and tagged templates are not call expressions, and
// the original rule ignores them too.
pattern anti_slop_module_mock($name) {
	JsCallExpression(callee = $callee) as $node where {
		$callee <: or {
			JsStaticMemberExpression(object = $dottedObject, member = $dottedMember) where {
				$dottedObject <: anti_slop_framework_object(name = $name),
				$dottedMember <: anti_slop_mock_method()
			},
			JsComputedMemberExpression(object = $keyedObject, member = $key) where {
				$keyedObject <: anti_slop_framework_object(name = $name),
				$key <: anti_slop_mock_key()
			}
		},
		$node <: not within anti_slop_binds_locally(name = $name),
		register_diagnostic(
			span = $node,
			message = "anti-slop/no-module-mocking: Replace module mocking with dependency injection through a real interface, service layer, or faithful test implementation.",
			severity = "error"
		)
	}
}

// One `maybe` per framework name, so shadowing `vi` leaves `jest` detection intact. The
// third and fourth blocks pick up `import { vi as x } from "vitest"` -- the import proves
// what `x` is, exactly as the original rule's import-binding check does. Those two use a
// plain `contains` (no `bubble`): `bubble` would drop the `$viAlias` binding and the inner
// pattern would then match any object at all.
file($body) where {
	maybe {
		$body <: not contains anti_slop_declared_in_file(
			name = `vi`,
			framework = or { `"vitest"`, `'vitest'` }
		),
		$body <: contains bubble anti_slop_module_mock(name = `vi`)
	},
	maybe {
		$body <: not contains anti_slop_declared_in_file(
			name = `jest`,
			framework = or { `"@jest/globals"`, `'@jest/globals'` }
		),
		$body <: contains bubble anti_slop_module_mock(name = `jest`)
	},
	maybe {
		$body <: contains JsImportNamedClause(
			named_specifiers = $viSpecifiers,
			source = $viSource
		) where {
			$viSource <: or { `"vitest"`, `'vitest'` },
			$viSpecifiers <: contains JsNamedImportSpecifier(
				name = $viImported,
				local_name = $viAlias
			) where {
				$viImported <: r"vi"
			}
		},
		$body <: contains anti_slop_module_mock(name = $viAlias)
	},
	maybe {
		$body <: contains JsImportNamedClause(
			named_specifiers = $jestSpecifiers,
			source = $jestSource
		) where {
			$jestSource <: or { `"@jest/globals"`, `'@jest/globals'` },
			$jestSpecifiers <: contains JsNamedImportSpecifier(
				name = $jestImported,
				local_name = $jestAlias
			) where {
				$jestImported <: r"jest"
			}
		},
		$body <: contains anti_slop_module_mock(name = $jestAlias)
	}
}
