language js

// anti-slop/no-unknown-returns
// A function whose explicit return contract is `unknown` hands the caller a value with no
// evidence attached: every consumer has to re-narrow it, and the narrowing is never checked
// against the producer. Parse at the boundary and return a named domain type instead.
// `Promise<unknown>` and unions containing `unknown` are the same contract wearing a wrapper.
// Ported from oxlint-plugin-anti-slop `no-unknown-returns`.
//
// The `or` lists every Biome node that can carry an explicit return type. These are AST node
// patterns rather than snippets: snippets cannot reach interface or type-literal members
// (docs/GRITQL-NOTES.md), and node patterns can. `TsReturnTypeAnnotation` alone covers
// function declarations and expressions, arrows, `declare function`, overload signatures,
// class and object methods, abstract and ambient methods, and interface / type-literal
// method and call signatures; the rest are the shapes that store their type elsewhere.
// `$node` is bound to the return type itself so the diagnostic points where the original does.
or {
	TsReturnTypeAnnotation(ty = $type),
	TsFunctionType(return_type = $type),
	TsConstructorType(return_type = $type),
	TsConstructSignatureTypeMember(type_annotation = TsTypeAnnotation(ty = $type)),
	TsGetterSignatureTypeMember(type_annotation = TsTypeAnnotation(ty = $type)),
	TsGetterSignatureClassMember(return_type = TsTypeAnnotation(ty = $type)),
	JsGetterClassMember(return_type = TsTypeAnnotation(ty = $type)),
	JsGetterObjectMember(return_type = TsTypeAnnotation(ty = $type))
} where {
	$type <: unknown_contract() as $node,
	register_diagnostic(
		span = $node,
		message = "anti-slop/no-unknown-returns: This function exposes `unknown` to its caller. Parse the value at its boundary and return a named domain type.",
		severity = "error"
	)
}

// A return type "is unknown" if it is the `unknown` keyword, a parenthesised wrapper around
// one, a union with an `unknown` member, or a Promise/PromiseLike resolving to one.
// Each branch must be spelled `Node(field = $var) where { $var <: ... }`: a pattern call
// written straight into a field position silently fails to match whenever the subject came
// from a snippet metavariable, which is how `Promise<(unknown)>` used to slip through.
pattern unknown_contract() {
	or {
		`unknown`,
		TsParenthesizedType(ty = $inner) where { $inner <: unknown_contract() },
		TsUnionType(types = $variants) where { $variants <: some unknown_contract() },
		`Promise<$resolved>` where { $resolved <: unknown_contract() },
		`PromiseLike<$resolved>` where { $resolved <: unknown_contract() }
	}
}
