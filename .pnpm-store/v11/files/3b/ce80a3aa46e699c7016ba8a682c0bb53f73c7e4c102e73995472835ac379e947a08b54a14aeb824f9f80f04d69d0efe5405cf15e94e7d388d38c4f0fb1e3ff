#!/usr/bin/env node
// biome-anti-slop installer.
//
//   npx biome-anti-slop init      wire the shared config into this project's biome.json
//   npx biome-anti-slop vendor    copy the .grit files into the repo and own them
//   npx biome-anti-slop doctor    check that the rules are actually loading
//
// `init` is the one-line path. `vendor` exists because these rules are opinionated: upstream
// anti-slop is meant to be read and edited, not consumed as a frozen dependency.

import { execFileSync } from "node:child_process";
import {
	copyFileSync,
	existsSync,
	mkdirSync,
	readFileSync,
	readdirSync,
	unlinkSync,
	writeFileSync,
} from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const PKG_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const PKG_NAME = "biome-anti-slop";
const CWD = process.cwd();

const args = process.argv.slice(2);
const command = args.find((a) => !a.startsWith("-")) ?? "init";
const flag = (name) => args.includes(`--${name}`);
const DRY = flag("dry-run");

const c = process.stdout.isTTY
	? { dim: (s) => `\x1b[2m${s}\x1b[0m`, bold: (s) => `\x1b[1m${s}\x1b[0m`, green: (s) => `\x1b[32m${s}\x1b[0m`, yellow: (s) => `\x1b[33m${s}\x1b[0m`, red: (s) => `\x1b[31m${s}\x1b[0m` }
	: { dim: (s) => s, bold: (s) => s, green: (s) => s, yellow: (s) => s, red: (s) => s };

function fail(message) {
	console.error(`${c.red("error")} ${message}`);
	process.exit(1);
}

function ruleNames() {
	return readdirSync(join(PKG_ROOT, "plugins"))
		.filter((f) => f.endsWith(".grit"))
		.map((f) => f.replace(/\.grit$/, ""))
		.sort();
}

function findConfig() {
	for (const name of ["biome.json", "biome.jsonc"]) {
		const path = join(CWD, name);
		if (existsSync(path)) return { path, name };
	}
	return null;
}

/** Comments and trailing commas survive JSON.parse round-trips badly; detect and bail out. */
function hasCommentsOrTrailingCommas(source) {
	let inString = false;
	let escaped = false;
	for (let i = 0; i < source.length; i += 1) {
		const ch = source[i];
		if (inString) {
			if (escaped) escaped = false;
			else if (ch === "\\") escaped = true;
			else if (ch === '"') inString = false;
			continue;
		}
		if (ch === '"') inString = true;
		else if (ch === "/" && (source[i + 1] === "/" || source[i + 1] === "*")) return true;
		else if (ch === ",") {
			const rest = source.slice(i + 1).replace(/\s/g, "");
			if (rest.startsWith("}") || rest.startsWith("]")) return true;
		}
	}
	return false;
}

function isInstalled() {
	return existsSync(join(CWD, "node_modules", PKG_NAME, "package.json"));
}

function biomeBin() {
	for (const candidate of [
		join(CWD, "node_modules", ".bin", "biome"),
		join(CWD, "node_modules", "@biomejs", "biome", "bin", "biome"),
	]) {
		if (existsSync(candidate)) return candidate;
	}
	return null;
}

function init() {
	const config = findConfig();
	const snippet = `{\n\t"extends": ["${PKG_NAME}"]\n}`;

	if (!config) {
		const target = join(CWD, "biome.json");
		const contents = `{\n\t"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",\n\t"extends": ["${PKG_NAME}"]\n}\n`;
		if (DRY) {
			console.log(`${c.dim("would create")} biome.json\n${contents}`);
		} else {
			writeFileSync(target, contents);
			console.log(`${c.green("created")} biome.json`);
		}
		postInstallNotes();
		return;
	}

	const source = readFileSync(config.path, "utf8");
	if (hasCommentsOrTrailingCommas(source)) {
		console.log(`${c.yellow("skipped")} ${config.name} contains comments; rewriting it would delete them.`);
		console.log(`\nAdd this to ${config.name} by hand:\n\n${snippet}\n`);
		postInstallNotes();
		return;
	}

	let parsed;
	try {
		parsed = JSON.parse(source);
	} catch (error) {
		fail(`could not parse ${config.name}: ${error.message}`);
	}

	const existing = parsed.extends ?? [];
	const list = Array.isArray(existing) ? existing : [existing];
	if (list.includes(PKG_NAME) || list.some((e) => typeof e === "string" && e.startsWith(`${PKG_NAME}/`))) {
		console.log(`${c.dim("already configured")} ${config.name} already extends ${PKG_NAME}`);
		postInstallNotes();
		return;
	}

	// Biome applies extends left to right, later entries winning. Appending means anti-slop
	// layers on top of whatever the project already had, which is the behaviour people expect.
	parsed.extends = [...list, PKG_NAME];
	const output = `${JSON.stringify(parsed, null, "\t")}\n`;
	if (DRY) {
		console.log(`${c.dim("would update")} ${config.name}\n${output}`);
	} else {
		writeFileSync(config.path, output);
		console.log(`${c.green("updated")} ${config.name} ${c.dim(`(extends += "${PKG_NAME}")`)}`);
		console.log(c.dim("  note: rewritten as formatted JSON; run your formatter if the diff looks noisy"));
	}
	postInstallNotes();
}

function postInstallNotes() {
	const rules = ruleNames();
	console.log(`\n${c.bold(`${rules.length} rules enabled`)}`);
	if (!isInstalled()) {
		console.log(
			`\n${c.yellow("next")} ${PKG_NAME} is not in this project's node_modules yet. The config will not\n     resolve until you install it:\n\n       npm install --save-dev ${PKG_NAME}\n`,
		);
	} else {
		console.log(`\nCheck it is working:\n\n       npx ${PKG_NAME} doctor\n`);
	}
}

function vendor() {
	const dest = resolve(CWD, args.find((a) => !a.startsWith("-") && a !== "vendor") ?? "biome/anti-slop");
	const rules = ruleNames();
	if (!DRY) mkdirSync(dest, { recursive: true });
	for (const rule of rules) {
		const from = join(PKG_ROOT, "plugins", `${rule}.grit`);
		const to = join(dest, `${rule}.grit`);
		if (DRY) console.log(`${c.dim("would copy")} ${relative(CWD, to)}`);
		else copyFileSync(from, to);
	}
	const rel = relative(CWD, dest).split("\\").join("/");
	const plugins = rules.map((r) => `\t\t"./${rel}/${r}.grit"`).join(",\n");
	console.log(
		`${DRY ? c.dim("would vendor") : c.green("vendored")} ${rules.length} rules into ${rel}/\n\nAdd to biome.json:\n\n{\n\t"plugins": [\n${plugins}\n\t]\n}\n\nThese files are yours now. Read them, delete the ones you disagree with, edit the rest.`,
	);
}

function doctor() {
	const bin = biomeBin();
	if (!bin) fail("could not find Biome in this project. Install it: npm install --save-dev @biomejs/biome");

	const probe = join(CWD, `.anti-slop-probe-${process.pid}.ts`);
	writeFileSync(probe, "declare const o: Record<string, string>;\ndeclare const k: string;\nconst v = Reflect.get(o, k);\n");
	let stdout = "";
	try {
		stdout = execFileSync(bin, ["lint", "--reporter=json", probe], { cwd: CWD, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
	} catch (error) {
		stdout = error.stdout ?? "";
	} finally {
		try {
			unlinkSync(probe);
		} catch {}
	}

	let diagnostics = [];
	try {
		diagnostics = JSON.parse(stdout).diagnostics ?? [];
	} catch {
		fail(`Biome did not return parseable output. Run \`npx biome lint\` yourself to see why.`);
	}

	const broken = diagnostics.filter((d) => /Cannot read file|errored:|Error\(s\) during loading/.test(d.message));
	if (broken.length) {
		console.log(`${c.red("broken")} plugins are configured but not loading:\n`);
		for (const d of broken) console.log(`  ${d.message}`);
		console.log(
			`\nBiome resolves plugin paths relative to the project root, not relative to the config\nthat declares them. If you extend ${PKG_NAME}, the package must be installed in THIS\nproject's node_modules (not hoisted out of reach, and not Yarn PnP). Try:\n\n       npm install --save-dev ${PKG_NAME}\n\nor vendor the rules instead:\n\n       npx ${PKG_NAME} vendor\n`,
		);
		process.exit(1);
	}

	const hit = diagnostics.find((d) => d.message.includes("anti-slop/"));
	if (!hit) {
		console.log(`${c.yellow("inactive")} Biome ran but no anti-slop rule fired on a known violation.`);
		console.log(`\nThe config is probably not wired up. Run:\n\n       npx ${PKG_NAME} init\n`);
		process.exit(1);
	}
	console.log(`${c.green("ok")} anti-slop is active ${c.dim(`(${ruleNames().length} rules available)`)}`);
	console.log(c.dim(`  probe diagnostic: ${hit.message.slice(0, 90)}...`));
}

function help() {
	console.log(`${c.bold(PKG_NAME)} — opinionated Biome lint rules

  npx ${PKG_NAME} init            add "extends": ["${PKG_NAME}"] to biome.json
  npx ${PKG_NAME} vendor [dir]    copy the .grit rules into your repo (default: biome/anti-slop)
  npx ${PKG_NAME} doctor          verify the rules are loading

  --dry-run    print what would change, change nothing

${ruleNames().length} rules:
${ruleNames().map((r) => `  ${r}`).join("\n")}
`);
}

switch (command) {
	case "init":
		init();
		break;
	case "vendor":
		vendor();
		break;
	case "doctor":
		doctor();
		break;
	case "help":
		help();
		break;
	default:
		if (flag("help") || flag("h")) help();
		else fail(`unknown command "${command}". Run \`npx ${PKG_NAME} help\`.`);
}
