language js

// anti-slop/no-conditional-empty-object-spread
// `{ ...(cond ? { a } : {}) }` hides property omission inside an expression: the shape of
// the resulting object is decided by a ternary whose empty branch means "no key at all".
// Build the object in named steps instead, so the omission is a statement a reader can see.
// Ported from oxlint-plugin-anti-slop `no-conditional-empty-object-spread`.
`...$arg` as $node where {
	// Peel parentheses -- and only parentheses -- off the spread argument, the way the
	// original's unwrapParentheses loop does. `until not `($_)`` stops the descent at the
	// first non-parenthesis node, so `...(f(cond ? {} : { a }))` and `...(x as T)` are left
	// alone exactly like the original leaves them.
	$arg <: contains `$cond ? $consequent : $alternate` until not `($_)`,
	// One branch must be an empty object literal -- that is the branch that omits the key.
	or { $consequent <: `{}`, $alternate <: `{}` },
	// Only object spreads count. GritQL exposes no parent access, so instead of the
	// original's `node.parent.type !== "ObjectExpression"` we require an enclosing object
	// literal that spreads this same argument.
	$node <: within `{ $..., ...$arg, $... }`,
	register_diagnostic(
		span = $node,
		message = "anti-slop/no-conditional-empty-object-spread: This conditional spread hides property omission behind an empty object. Build the object in separate statements and add the property only when present.",
		severity = "error"
	)
}
