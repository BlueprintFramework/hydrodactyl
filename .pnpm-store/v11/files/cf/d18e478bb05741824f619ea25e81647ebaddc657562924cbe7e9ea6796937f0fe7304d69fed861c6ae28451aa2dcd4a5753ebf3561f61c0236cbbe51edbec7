language js

// anti-slop/require-safety-comment-for-type-assertion
// A type assertion overrides the compiler, so the invariant it leans on has to be
// written down. Every assertion except `as const` needs a `SAFETY:` comment.
// Ported from oxlint-plugin-anti-slop `require-safety-comment-for-type-assertion`.
//
// Biome's GritQL cannot see comments: they are trivia rather than nodes, and a snippet
// containing one matches nothing. What a pattern *can* read is a node's source text,
// which covers every comment written between that node's first and last token. So the
// question "is there a `SAFETY:` comment here" can only be asked of a region, and the
// whole job of this rule is to make that region as small as the original's.
//
// The original walks up from the assertion, checking `getCommentsBefore` at every step,
// and gives up at the first ExpressionStatement / PropertyDefinition / ReturnStatement /
// ThrowStatement / VariableDeclaration. Call that stopping node the assertion's *owner*.
// Every comment the original would accept sits between the token that opens the region
// around the owner and the owner's own last token, so the region to search is:
//
//   1. `$owner`  -- the innermost enclosing statement the original stops at.
//   2. `$scope`  -- the innermost body, block, class, switch clause, loop, export or
//                   namespace containing `$owner`, or the module when there is no such
//                   node. Comments *before* `$owner` are trivia of its first token, so only
//                   a node that opens strictly earlier can see them.
//
// Both steps lean on one verified property of Biome's `within`: `$x <: within P` walks
// outward and binds the *innermost* ancestor at which `P` -- its own `where` clause
// included -- matches, and it does not retry outer ancestors when a *later, separate*
// predicate rejects that binding. So `$owner <: within anti_slop_scope($scope)` already
// means "the innermost enclosing region", and the `SAFETY:` test that follows it cannot
// silently widen the region by backtracking. An earlier revision re-proved innermost-ness
// with a second `not within ...nested...` walk; that was redundant, and being quadratic in
// nesting depth it cost 1.8s on a 1000-deep file that now takes 0.07s.
//
// Scoping the search is what keeps the rule alive as it is adopted: an earlier revision
// tested every ancestor including the file root, so the first `SAFETY:` comment written
// in a file switched the rule off for the rest of that file.
//
// One hole in that reasoning has to be plugged. A node's Grit text is its *trimmed*
// range, so it excludes the leading trivia of the file's very first token. A file that
// opens with `// SAFETY: ...` looks unjustified to the regex below, and that comment is
// exactly how the original wants the file's first statement annotated. No node's text can
// reach it, so `anti_slop_report()` reproduces, structurally, the set of assertions such a
// comment would excuse: the original's walk reaches the top of the file only when no owner
// sits strictly inside the first module item. Assertions in that position are left alone
// whether or not the comment is really there, which turns an unfixable false positive into
// a narrow false negative.
//
// Performance: `within` costs more than an ancestor walk, so the region is only computed
// for files that contain `SAFETY:` at all. A file without one cannot justify anything, and
// takes a single whole-file regex for the whole file rather than one per assertion.

// `$e as $t` as a snippet also matches `import { a as b }`, so both assertion forms are
// matched by node kind instead. `<T>value` has no snippet form at all: Biome parses `<T>`
// inside a snippet as JSX. Biome also gives an assertion in an assignment target
// (`(value as string) = x`) its own pair of node kinds.
pattern anti_slop_assertion($ty) {
	or {
		TsAsExpression(ty = $ty),
		TsTypeAssertionExpression(ty = $ty),
		TsAsAssignment(ty = $ty),
		TsTypeAssertionAssignment(ty = $ty)
	}
}

// The statements the original's walk gives up at. `export const x = ...` has no
// JsVariableStatement in Biome's CST -- the declaration hangs off the export in a
// JsVariableDeclarationClause -- so both spellings are listed. The two are disjoint node
// kinds, not nested, so an assertion never has two owners at the same place.
pattern anti_slop_owner($owner) {
	$owner where {
		$owner <: or {
			JsExpressionStatement(),
			JsReturnStatement(),
			JsThrowStatement(),
			JsVariableStatement(),
			JsVariableDeclarationClause(),
			JsPropertyClassMember()
		}
	}
}

// Every node that opens with a token of its own in front of the statements it holds, so
// its text spans the trivia those statements carry. A kind qualifies when a comment
// immediately before a statement it owns cannot escape it -- which is exactly when the
// node has at least one token (`{`, `case x:`, `if (c)`, `else`, `label:`) before that
// statement. A missing kind here only widens the search region, which can cost a report
// but can never invent one; a wrong kind would shrink it and cause a false positive.
//
// The clause and braceless-body kinds matter more than they look. A `switch` whose clauses
// are braceless (the normal spelling) would otherwise share one region across every clause,
// so a justification written for `case "a"` also silenced `default`. Same for the two arms
// of a braceless `if`. `JsExport` is here for the same reason: the original stops at the
// *declaration*, which starts at `const`, so a comment above `export` justifies nothing and
// the region for an `export const` is the export, not the enclosing braces. Object literals
// are deliberately absent: an owner is always a statement or a class property, never an
// object member.
pattern anti_slop_scope($scope) {
	$scope where {
		$scope <: or {
			JsFunctionBody(),
			JsBlockStatement(),
			JsStaticInitializationBlockClassMember(),
			JsClassDeclaration(),
			JsClassExpression(),
			JsSwitchStatement(),
			JsCaseClause(),
			JsDefaultClause(),
			JsIfStatement(),
			JsElseClause(),
			JsForStatement(),
			JsForInStatement(),
			JsForOfStatement(),
			JsWhileStatement(),
			JsDoWhileStatement(),
			JsLabeledStatement(),
			JsExport(),
			TsModuleBlock()
		}
	}
}

pattern anti_slop_module($module) {
	$module where { $module <: JsModule() }
}

// An owner strictly inside `$item`: the original's walk stops there instead of reaching
// the top of the file, so no leading comment could have justified the assertion.
pattern anti_slop_inner_owner($item) {
	anti_slop_owner($candidate_owner) where {
		$candidate_owner <: not $item,
		$candidate_owner <: within $item
	}
}

// Report, unless the assertion is one a comment on the file's first line could excuse.
pattern anti_slop_report() {
	$reported where {
		not {
			// A head-and-rest list pattern is the only way to name "the first module item"
			// here. If the root is not a module this fails and the assertion is reported,
			// which is the safe way round.
			$reported <: within JsModule(items = $items),
			$items <: [$first_item, ...],
			$reported <: within $first_item,
			$reported <: not within anti_slop_inner_owner($first_item)
		},
		register_diagnostic(
			span = $reported,
			message = "anti-slop/require-safety-comment-for-type-assertion: This type assertion has no `SAFETY:` justification. State the checked invariant immediately before the assertion or its containing statement.",
			severity = "error"
		),
		// `contains` stops at its first successful match, so the predicate is forced to
		// fail after the diagnostic is registered. That keeps the walk going and reports
		// every offending assertion in the file instead of only the first.
		$reported <: `__anti_slop_no_such_assertion__`
	}
}

file($body) where {
	or {
		// Nothing in this file can justify anything, so the region never has to be found.
		and {
			$body <: not r"(?s).*\bSAFETY\s*:.*",
			$body <: contains anti_slop_assertion($bare_ty) as $bare_node where {
				$bare_ty <: not r"const",
				$bare_node <: anti_slop_report()
			}
		},
		// The file holds at least one `SAFETY:`, so every assertion needs its own region.
		and {
			$body <: r"(?s).*\bSAFETY\s*:.*",
			$body <: contains anti_slop_assertion($ty) as $node where {
				$ty <: not r"const",
				or {
					and {
						$node <: within anti_slop_owner($owner),
						or {
							$owner <: within anti_slop_scope($scope),
							// A top-level owner sits inside no brace at all. `$body` is the
							// fallback for a root that is not a module, so an unexpected
							// root shape cannot leave `$scope` unbound and silently drop
							// every assertion in the file.
							and {
								$owner <: not within anti_slop_scope($unbraced),
								or {
									$node <: within anti_slop_module($scope),
									$scope = $body
								}
							}
						}
					},
					// No owner at all -- a decorator, a parameter default, a `switch`
					// test, an `extends` clause. The original's walk then runs to the
					// top-level item the assertion sits in, and comments before that item
					// live in the module's own text.
					and {
						$node <: not within anti_slop_owner($ownerless),
						or {
							$node <: within anti_slop_module($scope),
							$scope = $body
						}
					}
				},
				$scope <: not r"(?s).*\bSAFETY\s*:.*",
				$node <: anti_slop_report()
			}
		}
	}
}
