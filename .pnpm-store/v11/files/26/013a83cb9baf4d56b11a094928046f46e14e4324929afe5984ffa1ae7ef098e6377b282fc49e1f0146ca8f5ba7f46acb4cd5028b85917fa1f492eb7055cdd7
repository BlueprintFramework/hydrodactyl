language js

// anti-slop/no-chained-type-assertions
// `x as unknown as T` launders one type into an unrelated one by routing through a
// wider type, which throws away every check the compiler could have made. A chain
// built only from `as const` is allowed, because it narrows rather than widens.
// Ported from oxlint-plugin-anti-slop `no-chained-type-assertions`.
//
// The original handles both spellings of a type assertion. `x as T` is reachable as a
// snippet; the angle-bracket form `<T>x` is not (no snippet, literal or metavariable,
// ever matches it), so it is matched by its Biome CST node kind instead. An unknown
// node kind or field name is a hard plugin-compile error rather than a silent
// no-match, so this cannot rot into a quietly weaker rule.
pattern anti_slop_type_assertion($asserted_type, $operand) {
	or {
		`$operand as $asserted_type`,
		TsTypeAssertionExpression(ty = $asserted_type, expression = $operand)
	}
}

anti_slop_type_assertion($_, $operand) as $node where {
	// A chain needs at least two links. Parentheses are transparent, matching the
	// original's `unwrapParenthesizedExpression`; `until` keeps the walk on the
	// assertion spine, so an assertion buried inside an unrelated operand -- a call
	// argument, an array element, a ternary branch -- never counts as a link.
	$operand <: contains anti_slop_type_assertion($_, $_) until not `($_)`,
	// Chains built only from `as const` narrow rather than widen, so the original
	// permits them. Walk the whole spine and require at least one non-const link.
	$node <: contains anti_slop_type_assertion($link_type, $_) where {
		$link_type <: not r"const"
	} until not or { anti_slop_type_assertion($_, $_), `($_)` },
	// Report once per chain, on its outermost assertion, as the original does: stay
	// silent when this node is the parenthesis-stripped operand of an enclosing
	// assertion. This reproduces `isOutermostAssertionInChain`.
	$node <: not within anti_slop_type_assertion($_, $enclosing_operand) where {
		$enclosing_operand <: contains $node until not `($_)`
	},
	register_diagnostic(
		span = $node,
		message = "anti-slop/no-chained-type-assertions: This assertion chain discards type evidence. Keep the original precise type, or parse untrusted input at its boundary before narrowing it.",
		severity = "error"
	)
}
