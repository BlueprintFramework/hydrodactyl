language js

// anti-slop/no-widen-then-assert
// A local `const` that erases a known value's type (`unknown`, `any`, `object`,
// `Record<string, unknown>`) and is later asserted back to a narrower type has thrown away
// evidence the compiler already had, then forged it again by hand.
// Ported from oxlint-plugin-anti-slop `no-widen-then-assert`.
//
// The original rule uses scope analysis. Biome GritQL has none, so the binding is matched by
// name inside one syntactic region: the innermost enclosing function body, or the module top
// level. Three boundary sets keep that approximation honest:
//   * `anti_slop_static_boundary` -- every construct that opens a binding scope regardless of
//     the name being resolved.
//   * `anti_slop_scope_boundary` -- the above plus blocks, switch clauses and object literals.
//     Used when hunting for the widened declaration, so a same-named binding inside a nested
//     block, case clause or object literal can never be mistaken for the one the assertion sees.
//   * `anti_slop_reach_boundary($n)` -- the static set plus blocks and clauses that redeclare
//     `$n`. Tested against THIS assertion's own ancestors, so `if (...) { x as T }` is still
//     reported while a genuine shadow is not. It used to be a `contains` over the enclosing
//     body, which only asked whether SOME assertion of the same text was reachable and so
//     reported copies sitting inside a nested arrow on the strength of an outer one.
// Every boundary is only ever allowed to suppress a report, never to create one.
//
// Every boundary is a node kind. They used to be whole-node regexes, which was wrong three ways:
// `until`/`within` test their boundary against the ROOT node as well, so a file whose own text
// full-matched one (a generic function at the top, a `}` at the bottom) silently lost every
// module-level diagnostic in it; the generic-arrow regex could not cross a nested `<>`, so a
// constrained type parameter stopped shadowing; and no regex reached a braceless `case` clause.

// Constructs that open a binding scope no matter which name is being resolved.
pattern anti_slop_static_boundary() {
	or {
		JsFunctionDeclaration(),
		JsFunctionExportDefaultDeclaration(),
		JsFunctionExpression(),
		JsArrowFunctionExpression(),
		TsDeclareFunctionDeclaration(),
		JsClassDeclaration(),
		JsClassExportDefaultDeclaration(),
		JsClassExpression(),
		TsModuleDeclaration(),
		TsExternalModuleDeclaration(),
		JsCatchClause(),
		JsForStatement(),
		JsForOfStatement(),
		JsForInStatement()
	}
}

// A declaration that (re)binds `$n`. `JsVariableDeclarator` reaches `let` and `var`, which no
// snippet does; the previous version had to close a block off for *any* `let`/`var` in it.
pattern anti_slop_rebinds($n) {
	or {
		JsVariableDeclarator(id = $n),
		JsFunctionDeclaration(id = $n),
		JsClassDeclaration(id = $n)
	}
}

// A block or switch clause that redeclares `$n` in its OWN statement list: the binding the
// assertion sees is not the outer one. The search is bound to the statement list rather than the
// block, for two reasons. Correctness: a declaration inside a nested block or a nested function
// belongs to that scope, not this one, so it must not close this block off. Cost: an unbounded
// `contains` rescans the whole subtree once per enclosing block, which is quadratic in nesting
// depth -- 500 nested blocks around one assertion took 3.3s. `until` cannot be applied to the
// block directly, because it is tested against the subtree root too and a block is itself a
// scope boundary, which would make the search find nothing at all.
pattern anti_slop_shadowing_block($n) {
	or {
		JsBlockStatement(statements = $shadow_stmts),
		JsCaseClause(consequent = $shadow_stmts),
		JsDefaultClause(consequent = $shadow_stmts)
	} where {
		$shadow_stmts <: contains anti_slop_rebinds($n) until anti_slop_scope_boundary()
	}
}

// Boundary for the walk down to the assertion: plain braces stay open.
pattern anti_slop_reach_boundary($n) {
	or {
		anti_slop_static_boundary(),
		anti_slop_shadowing_block($n)
	}
}

// Every construct that can hold a binding the assertion's own scope cannot see. Switch clauses
// belong here even without braces: `case 0: const x = ...` declares `x` in the switch block.
pattern anti_slop_braced_scope() {
	or {
		JsBlockStatement(),
		JsObjectExpression(),
		JsCaseClause(),
		JsDefaultClause()
	}
}

// Boundary for the search for the widened declaration: every brace and clause closes.
pattern anti_slop_scope_boundary() {
	or {
		anti_slop_static_boundary(),
		anti_slop_braced_scope()
	}
}

// The body of a function, method, accessor or namespace -- the region a local binding lives in.
// This used to be `r"(?s)\{.*\}"` minus blocks and object literals, which also matched JSX
// expression containers, object binding patterns and mapped types; an assertion inside JSX got a
// two-character "function body" and was never reported, making the rule near-inert on .tsx.
pattern anti_slop_function_body($fnbody) {
	$fnbody where {
		$fnbody <: or {
			JsFunctionBody(),
			TsModuleBlock()
		}
	}
}

// `within` reports a node as being within itself, so identity is excluded by text.
pattern anti_slop_nested_function_body($outer) {
	anti_slop_function_body($inner) where {
		$inner <: not $outer,
		$inner <: within $outer
	}
}

// A reach boundary that sits strictly inside `$outer`.
pattern anti_slop_inner_reach_boundary($outer, $n) {
	anti_slop_reach_boundary($n) as $inner_boundary where {
		$inner_boundary <: not $outer,
		$inner_boundary <: within $outer
	}
}

// What has to be absent from an assertion's ancestors for it to belong to the module top
// level: any function-ish body, plus everything that opens a scope on the way there.
pattern anti_slop_enclosing_boundary($n) {
	or {
		anti_slop_reach_boundary($n),
		anti_slop_function_body($enclosing_body)
	}
}

// `unknown` / `any`: every non-broad assertion off one of these is a narrowing.
pattern anti_slop_top_type() {
	or {
		TsUnknownType(),
		TsAnyType()
	}
}

// The `object` keyword.
pattern anti_slop_object_keyword() {
	TsNonPrimitiveType()
}

// A record type keyed by every property name. These three stay regexes on purpose: the original
// requires the key union to be *entirely* broad and the index-signature literal to have exactly
// one member, and a whole-node regex is the only way to say "exactly this shape and nothing
// else" here. Biome full-matches a regex against the node's text, so `Partial<Record<string,
// unknown>>` does NOT match the first branch -- which is right, because the original does not
// treat it as broad either. They are only ever tested against a type node, never a whole file.
pattern anti_slop_broad_record() {
	or {
		r"(?s)Record\s*<\s*(?:string|number|symbol|PropertyKey)(?:\s*\|\s*(?:string|number|symbol|PropertyKey))*\s*,\s*(?:unknown|any)\s*>",
		r"(?s)Readonly\s*<\s*Record\s*<\s*(?:string|number|symbol|PropertyKey)(?:\s*\|\s*(?:string|number|symbol|PropertyKey))*\s*,\s*(?:unknown|any)\s*>\s*>",
		r"(?s)\{\s*(?:readonly\s+)?\[\s*[A-Za-z_$][A-Za-z0-9_$]*\s*:\s*(?:string|number|symbol|PropertyKey)\s*\]\s*:\s*(?:unknown|any)\s*[;,]?\s*\}"
	}
}

pattern anti_slop_broad_type() {
	or {
		anti_slop_top_type(),
		anti_slop_object_keyword(),
		anti_slop_broad_record()
	}
}

// A type literal carrying at least one *named* member. `until TsObjectType()` keeps the search
// inside this literal's own member list: `{ [k: string]: { a: string } }` is an index signature,
// not a member list, however many named members its value type has.
pattern anti_slop_member_list() {
	TsObjectType(members = $type_members) where {
		$type_members <: contains or {
			TsPropertySignatureTypeMember(),
			TsMethodSignatureTypeMember(),
			TsGetterSignatureTypeMember(),
			TsSetterSignatureTypeMember()
		} until TsObjectType()
	}
}

// A type literal carrying at least one member of any kind. `{}` is not an object type the
// original considers narrower than `object`; `{ [k: string]: Message }` is.
pattern anti_slop_nonempty_object_type() {
	TsObjectType(members = $object_members) where {
		$object_members <: contains or {
			TsPropertySignatureTypeMember(),
			TsMethodSignatureTypeMember(),
			TsGetterSignatureTypeMember(),
			TsSetterSignatureTypeMember(),
			TsIndexSignatureTypeMember(),
			TsCallSignatureTypeMember(),
			TsConstructSignatureTypeMember()
		} until TsObjectType()
	}
}

// The original's `isDefinitelyObjectType`: what is provably narrower than the `object` keyword.
// The intersection branch is the one approximation -- the original demands every member be
// provably an object, which no list quantifier here can express -- and `object as (A & B)` where
// one side is a primitive is not code anyone writes.
pattern anti_slop_definitely_object() {
	or {
		TsArrayType(),
		TsTupleType(),
		TsFunctionType(),
		TsConstructorType(),
		TsMappedType(),
		TsIntersectionType(),
		anti_slop_nonempty_object_type(),
		// The only type operator the original accepts is `readonly`, and TypeScript only permits
		// `readonly` on an array or tuple type. Matching the operand instead of the operator token
		// says the same thing without a regex: `operator_token` is not a field GritQL can bind,
		// and recursing on `anti_slop_definitely_object()` here would also accept
		// `keyof { a: string }`, which is a string union, not an object.
		TsTypeOperatorType(ty = $readonly_operand) where {
			$readonly_operand <: or { TsArrayType(), TsTupleType() }
		},
		TsParenthesizedType(ty = $paren_object_type) where {
			$paren_object_type <: anti_slop_definitely_object()
		}
	}
}

// The original's `isDefinitelyNarrowerRecordType`: what is provably narrower than a broad
// record. An index signature spelled longhand is not, and neither is an array -- which is why
// the two broad kinds cannot share one narrowness test. The original's `Readonly<...>` recursion
// is deliberately left out: matching it here would need "the sole type argument", and `contains`
// would instead accept `Readonly<Array<{ a: string }>>`, which is not narrower.
pattern anti_slop_narrower_record() {
	or {
		anti_slop_member_list(),
		TsReferenceType(name = $narrow_ref, type_arguments = $narrow_args) where {
			$narrow_ref <: r"Record",
			$narrow_args <: not contains anti_slop_top_type()
		},
		TsParenthesizedType(ty = $paren_record_type) where {
			$paren_record_type <: anti_slop_narrower_record()
		}
	}
}

// Expressions whose type the compiler already knows without an annotation.
pattern anti_slop_known_value() {
	or {
		JsObjectExpression(),
		JsArrayExpression(),
		JsNewExpression(),
		JsArrowFunctionExpression(),
		JsFunctionExpression(),
		JsClassExpression(),
		JsStringLiteralExpression(),
		JsNumberLiteralExpression(),
		JsBigintLiteralExpression(),
		JsBooleanLiteralExpression(),
		JsNullLiteralExpression(),
		JsRegexLiteralExpression(),
		// A TAGGED template is the same node kind as a plain one, and its type is whatever the tag
		// function returns, so a sql/gql/css tagged template is not literal evidence. The original
		// only accepts an untagged TemplateLiteral, so require the `tag` slot to be empty.
		JsTemplateExpression(tag = $template_tag) where { $template_tag <: . },
		`$_ as $known_type` where { $known_type <: not anti_slop_broad_type() }
	}
}

// A `const` in the same region that gives `$binding` a known type.
pattern anti_slop_known_binding($binding) {
	or {
		`const $binding = $binding_value` where {
			$binding_value <: anti_slop_known_value()
		},
		`const $binding: $binding_type = $_` where {
			$binding_type <: not anti_slop_broad_type()
		}
	}
}

pattern anti_slop_known_expression($scope) {
	or {
		anti_slop_known_value(),
		$evidence_ref where {
			$evidence_ref <: JsIdentifierExpression(),
			$scope <: contains anti_slop_known_binding($evidence_ref) until anti_slop_scope_boundary()
		}
	}
}

pattern anti_slop_widened_top($name, $scope) {
	or {
		`const $name: $declared = $init` where {
			$declared <: anti_slop_top_type(),
			$init <: anti_slop_known_expression($scope)
		},
		`const $name = $wrapped as $widened` where {
			$widened <: anti_slop_top_type(),
			$wrapped <: anti_slop_known_expression($scope)
		}
	}
}

// Off `object` only a provably-object type is narrower; off a broad record only a member list
// or a record with a narrower value type is. The two are kept apart because `readonly T[]` is
// narrower than `object` but not narrower than `Record<string, unknown>`.
pattern anti_slop_broad_object_for($asserted) {
	$broad where {
		or {
			and {
				$broad <: anti_slop_object_keyword(),
				$asserted <: anti_slop_definitely_object()
			},
			and {
				$broad <: anti_slop_broad_record(),
				$asserted <: anti_slop_narrower_record()
			}
		}
	}
}

pattern anti_slop_widened_object($name, $scope, $asserted) {
	or {
		`const $name: $declared2 = $init2` where {
			$declared2 <: anti_slop_broad_object_for($asserted),
			$init2 <: anti_slop_known_expression($scope)
		},
		`const $name = $wrapped2 as $widened2` where {
			$widened2 <: anti_slop_broad_object_for($asserted),
			$wrapped2 <: anti_slop_known_expression($scope)
		}
	}
}

file($body) where {
	$body <: contains `$name as $asserted` as $node where {
		$name <: JsIdentifierExpression(),
		$asserted <: not anti_slop_broad_type(),
		// Pin $scope to the region that holds the assertion: the innermost enclosing function
		// body, or the module top level when the assertion is in no function at all.
		or {
			and {
				$node <: within anti_slop_function_body($fnbody),
				// `within` offers every enclosing body; keep only the innermost one.
				$node <: not within anti_slop_nested_function_body($fnbody),
				// ... and only when nothing that opens a scope sits on the way down to it.
				$node <: not within anti_slop_inner_reach_boundary($fnbody, $name),
				$scope = $fnbody
			},
			and {
				$node <: not within anti_slop_enclosing_boundary($name),
				$scope = $body
			}
		},
		or {
			$scope <: contains anti_slop_widened_top($name, $scope) until anti_slop_scope_boundary(),
			and {
				$asserted <: or {
					anti_slop_definitely_object(),
					anti_slop_narrower_record()
				},
				$scope <: contains anti_slop_widened_object($name, $scope, $asserted) until anti_slop_scope_boundary()
			}
		},
		register_diagnostic(
			span = $node,
			message = "anti-slop/no-widen-then-assert: This binding discards type evidence and later recreates it with an assertion. Keep the precise type from initialization through use; parse boundary input once.",
			severity = "error"
		),
		// `contains` stops at its first successful match, so the predicate is forced to fail
		// after the diagnostic is registered. That keeps the walk going and reports every
		// offending assertion in the file instead of only the first.
		$name <: `__anti_slop_no_such_binding__`
	}
}
