language js

// anti-slop/no-shape-in-symbol-names
// "shape" names a symbol after its structure instead of its domain role, which
// hides what the value owns and invites structural typing to stand in for meaning.
// Rejects the case-insensitive substring "shape" in every declared or referenced
// name: bindings, references, assignment targets, member and private names, object
// and class member keys, labels, export/import aliases, JSX names, type-alias,
// interface, enum, namespace and type-parameter names, enum members, and import
// attribute keys.
// Ported from oxlint-plugin-anti-slop `no-shape-in-symbol-names`.
//
// String literals, template text, JSX text and comments are deliberately untouched:
// the original rule only visits Identifier / PrivateIdentifier / JSXIdentifier nodes.
// The regex is a whole-node match, so a quoted key, a quoted enum member or a string
// import/export alias (`{ "shape": 1 }`, `export { x as "shape" }`) carries quotes in
// its text and stays clean, exactly as the original leaves those Literal nodes alone.
or {
	or {
		JsIdentifierBinding(),
		JsReferenceIdentifier(),
		JsIdentifierAssignment(),
		JsName(),
		JsPrivateName(),
		JsPrivateClassMemberName(),
		JsLiteralMemberName(),
		JsLiteralExportName(),
		JsLabel(),
		JsxName(),
		JsxReferenceIdentifier(),
		TsIdentifierBinding(),
		TsTypeParameterName(),
		TsLiteralEnumMemberName()
	} as $node where {
		$node <: r"(?i)#?[\w$-]*shape[\w$-]*",
		register_diagnostic(
			span = $node,
			message = "anti-slop/no-shape-in-symbol-names: Rename this symbol for its domain role; 'shape' describes structure rather than ownership.",
			severity = "error"
		)
	},
	// `import x from "./d.json" with { shapeType: "json" }`. Biome keeps the attribute
	// key as a bare token, so the whole `key: value` entry is the innermost matchable
	// node; the regex therefore anchors "shape" to the key half, which keeps a shape-y
	// *value* (`with { type: "shape" }`) and a quoted key clean.
	JsImportAssertionEntry() as $entry where {
		$entry <: r"(?is)[\w$-]*shape[\w$-]*\s*:.*",
		register_diagnostic(
			span = $entry,
			message = "anti-slop/no-shape-in-symbol-names: Rename this symbol for its domain role; 'shape' describes structure rather than ownership.",
			severity = "error"
		)
	}
}
